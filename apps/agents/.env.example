# NEAR network: testnet or mainnet
NETWORK=testnet
# Vault that issued the card
VAULT_ID=demo.factory.comatocard.testnet
# Indexer the guard asks for counterparty risk before signing
INDEXER_URL=http://localhost:4000
# Card secret key, ed25519:<base58>. Keep it in .env, which git ignores.
CARD_PRIVATE_KEY=
# Optional override, defaults to the public RPC of NETWORK
RPC_URL=
LOG_LEVEL=info
# Treasury dry run: an existing mainnet account for the 1Click quote, optional limits
TREASURY_ACCOUNT=
TREASURY_SLIPPAGE_BPS=
TREASURY_MAX_SWAP_USD=
ONECLICK_JWT=
