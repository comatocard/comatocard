{
  "name": "@comatocard/agents",
  "version": "0.1.0",
  "private": true,
  "description": "Comatocard agents that hold card keys",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./policy-assistant": {
      "types": "./dist/policy-assistant.d.ts",
      "import": "./dist/policy-assistant.js"
    },
    "./private-chat": {
      "types": "./dist/private-chat.d.ts",
      "import": "./dist/private-chat.js"
    },
    "./treasury": {
      "types": "./dist/treasury.d.ts",
      "import": "./dist/treasury.js"
    },
    "./oneclick": {
      "types": "./dist/oneclick.d.ts",
      "import": "./dist/oneclick.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check . && eslint . --max-warnings 0",
    "test": "vitest run --coverage",
    "status": "node --env-file=.env dist/status.js",
    "pay": "node --env-file=.env dist/pay.js",
    "treasury": "node --env-file=.env dist/treasury-cli.js",
    "policy": "node --env-file=.env dist/policy-cli.js",
    "mcp": "node --env-file=.env dist/mcp.js"
  },
  "dependencies": {
    "@comatocard/sdk": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "near-api-js": "7.5.3",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@comatocard/config": "workspace:*",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
