{
  "name": "@comatocard/docs",
  "version": "0.0.0",
  "private": true,
  "description": "Comatocard documentation site",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build && pagefind --site out --output-path out/_pagefind",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "biome check . && eslint . --max-warnings 0",
    "test": "node --test"
  },
  "dependencies": {
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/server": "11.11.0",
    "@emotion/styled": "11.14.1",
    "@mui/material": "9.5.0",
    "@mui/material-nextjs": "9.5.0",
    "clsx": "2.1.1",
    "motion": "14.12.0",
    "next": "16.4.6",
    "next-themes": "0.4.6",
    "nextra": "4.6.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@comatocard/config": "workspace:*",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "pagefind": "1.6.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3"
  }
