{
  "name": "@comatocard/docs",
  "version": "0.0.0",
  "private": true,
  "description": "Comatocard documentation site",
  "license": "MIT",
  "scripts": {
    "sync": "node scripts/sync-content.mjs",
    "dev": "node scripts/sync-content.mjs && next dev -p 3001",
    "build": "node scripts/sync-content.mjs && next build",
    "typecheck": "node scripts/sync-content.mjs && tsc --project tsconfig.json --noEmit",
    "lint": "biome check . && eslint . --max-warnings 0",
    "test": "node --test"
  },
  "dependencies": {
    "@emotion/cache": "11.11.0",
    "@emotion/react": "11.11.3",
    "@emotion/serialize": "1.1.3",
    "@emotion/server": "11.11.0",
    "@emotion/styled": "11.11.0",
    "@mui/material": "5.18.0",
    "@reduxjs/toolkit": "1.9.7",
    "@shikijs/transformers": "1.3.0",
    "clsx": "1.2.1",
    "framer-motion": "6.5.1",
    "lodash-es": "4.17.21",
    "next": "14.2.35",
    "next-seo": "6.0.0",
    "nextra": "2.13.4",
    "nextra-theme-docs": "2.13.4",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-redux": "8.1.3",
    "react-use": "17.4.3",
    "shiki": "1.3.0",
    "twin.macro": "3.1.0"
  },
  "devDependencies": {
    "@comatocard/config": "workspace:*",
    "@emotion/babel-plugin": "11.11.0",
    "@tailwindcss/line-clamp": "0.4.4",
    "@types/lodash-es": "4.17.12",
    "@types/node": "17.0.45",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "autoprefixer": "10.4.16",
    "babel-plugin-macros": "3.1.0",
    "eslint": "10.14.0",
    "postcss": "8.4.33",
    "tailwindcss": "3.2.6",
    "typescript": "5.0.4"
  },
  "babelMacros": {
    "twin": {
      "config": "./tailwind.config.js",
      "preset": "emotion",
      "disableShortCss": false
    }
  }
}
