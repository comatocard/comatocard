{
  "name": "@comatocard/docs",
  "version": "0.0.0",
  "private": true,
  "description": "Comatocard documentation site",
  "license": "MIT",
  "scripts": {
    "sync": "node scripts/sync-content.mjs",
    "dev": "node scripts/sync-content.mjs && next dev -p 3001",
    "build": "node scripts/sync-content.mjs && next build",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "biome check . && eslint . --max-warnings 0",
    "test": "node --test"
  },
  "dependencies": {
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/serialize": "1.3.3",
    "@emotion/server": "11.11.0",
    "@emotion/styled": "11.14.1",
    "@mui/material": "5.18.0",
    "@reduxjs/toolkit": "1.9.7",
    "@shikijs/transformers": "1.29.2",
    "clsx": "1.2.1",
    "framer-motion": "6.5.1",
    "lodash-es": "4.18.1",
    "next": "14.2.35",
    "next-seo": "6.8.0",
    "nextra": "2.13.4",
    "nextra-theme-docs": "2.13.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-redux": "8.1.3",
    "react-use": "17.6.1",
    "shiki": "1.29.2",
    "twin.macro": "3.4.1"
  },
  "devDependencies": {
    "@comatocard/config": "workspace:*",
    "@emotion/babel-plugin": "11.13.5",
    "@types/lodash-es": "4.17.12",
    "@types/node": "17.0.45",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "autoprefixer": "10.6.2",
    "babel-plugin-macros": "3.1.0",
    "eslint": "10.14.0",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  },
  "babelMacros": {
    "twin": {
      "config": "./tailwind.config.js",
      "preset": "emotion",
      "disableShortCss": false
    }
  }
}
