# NEAR network to index: testnet or mainnet
NETWORK=testnet
# Contracts to index; vaults are every account ending in .<FACTORY_ID>
FACTORY_ID=factory.comatocard.testnet
REGISTRY_ID=registry.comatocard.testnet
# Postgres connection, see docker-compose.yml
DATABASE_URL=postgres://comatocard:comatocard@localhost:5432/comatocard
# First block to index when the database is empty; defaults to the current final block
START_BLOCK=
# Optional overrides
NEARDATA_URL=
NEARDATA_API_KEY=
# Minimum milliseconds between neardata requests; defaults to 350 without an API key
NEARDATA_MIN_INTERVAL_MS=
RPC_URL=
PORT=4000
# Milliseconds between head checks at the chain tip; 2000 keeps testnet under the free tier
POLL_INTERVAL_MS=
# error, warn, info, debug or trace
LOG_LEVEL=info
