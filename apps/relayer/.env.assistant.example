# Policy assistant service (pnpm start:assistant). It never holds the relayer key.
NETWORK=testnet
# Only cards of this factory's vaults are read
FACTORY_ID=factory.comatocard.testnet
# NEAR AI Cloud key; the service refuses to start without it. Keep it in .env.assistant, which git ignores.
NEAR_AI_API_KEY=
PORT=4200
LOG_LEVEL=info
# Optional overrides
RPC_URL=
NEAR_AI_BASE_URL=
POLICY_MODEL=
