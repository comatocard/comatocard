# NEAR network: testnet or mainnet
NETWORK=testnet
# Only vaults of this factory are sponsored
FACTORY_ID=factory.comatocard.testnet
# Indexer that screens withdraw receivers; unreachable means refused
INDEXER_URL=http://localhost:4000
# Account that signs and pays for the wrapping transactions. Keep the key in .env, which git ignores.
RELAYER_ACCOUNT_ID=
RELAYER_PRIVATE_KEY=
PORT=4100
LOG_LEVEL=info
# Optional override, defaults to the public RPC of NETWORK
RPC_URL=

# owner-call only: the owner signs, the relayer pays
OWNER_ACCOUNT_ID=
OWNER_PRIVATE_KEY=
RELAYER_URL=http://localhost:4100
