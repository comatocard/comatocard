# NEAR network: testnet or mainnet
NEXT_PUBLIC_NETWORK=testnet
# Optional override, defaults to FastNEAR for the network
NEXT_PUBLIC_RPC_URL=
# Merchant of /shop
NEXT_PUBLIC_MERCHANT_ID=comatocard-shop.testnet
# Factory that creates vaults, and the settlement token
NEXT_PUBLIC_FACTORY_ID=factory.comatocard.testnet
NEXT_PUBLIC_TOKEN_ID=tusd.comatocard.testnet
# Indexer the server proxies to (REST), and the WebSocket the browser opens for the live feed
INDEXER_URL=http://localhost:4000
NEXT_PUBLIC_INDEXER_WS_URL=ws://localhost:4000
# Relayer that sponsors owner actions
RELAYER_URL=http://localhost:4100
# Policy assistant on NEAR AI Cloud, server only. Keep it in .env.local, which git ignores.
NEAR_AI_API_KEY=
POLICY_MODEL=
# Treasury dry run: an existing mainnet account that would receive the swap; only used to quote
TREASURY_ACCOUNT=
ONECLICK_JWT=
