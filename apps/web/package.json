    "motion": "14.10.0",
    "near-api-js": "7.4.0",
    "near-connect-hooks": "1.1.6",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "thinking-orbs": "0.3.2",
