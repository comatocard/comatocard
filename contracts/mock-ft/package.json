{
  "name": "@comatocard/mock-ft",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "lint": "cargo clippy -p mock-ft --all-targets -- -D warnings && cargo fmt -p mock-ft -- --check",
    "test": "cargo test -p mock-ft --lib",
    "test:integration": "cargo test -p mock-ft --tests",
    "build": "cargo near build non-reproducible-wasm --locked --manifest-path Cargo.toml"
  }
}
