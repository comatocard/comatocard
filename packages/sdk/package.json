{
  "name": "@comatocard/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Comatocard contract types, event schemas and vault client",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check . && eslint . --max-warnings 0",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@comatocard/config": "workspace:*",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
